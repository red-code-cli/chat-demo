{
  "name": "@redcode/server",
  "version": "0.1.0",
  "private": true,
  "description": "RedCode backend: hosts the OpenCode server behind an authenticated Hono API.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.9",
    "@opencode-ai/sdk": "1.19.6",
    "hono": "4.13.19",
    "opencode-ai": "1.19.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
