# RedCode server configuration.
# Copy this file to server/.env and fill in the required values.
# Never commit server/.env.

# Public HTTP listener. Keep 127.0.0.1 unless a reverse proxy fronts the server.
HOST=127.0.0.1
PORT=8787

# Required. At least 16 characters. Generate one with: openssl rand -hex 32
APP_AUTH_TOKEN=replace-me-with-a-long-random-token

# Required. Comma-separated browser origins allowed to call the API.
# Wildcards are rejected. Example: http://localhost:8080,https://app.example.com
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Required. Absolute path that OpenCode may work in. Must already exist.
WORKSPACE_ROOT=/absolute/path/to/workspace

# embedded: spawn the pinned opencode-ai CLI on 127.0.0.1.
# remote: connect to an already running OpenCode V1 server.
OPENCODE_MODE=embedded

# Required only when OPENCODE_MODE=remote. Example: http://127.0.0.1:4096
OPENCODE_BASE_URL=

# Optional but recommended. Format: provider/model.
# Used as the inline OpenCode model and as the default prompt model.
OPENCODE_MODEL=deepseek/deepseek-chat

# Optional. Server-side provider API key for embedded mode.
# It is written into the inline OpenCode config and never sent to the browser.
OPENCODE_PROVIDER_API_KEY=

# Optional. Basic-auth password for a remote OpenCode server.
# Embedded mode generates a random password per process and ignores this value.
OPENCODE_SERVER_PASSWORD=

# Optional. Root directory for embedded OpenCode data, config, and state.
# Defaults to server/.data/opencode. Keep it outside WORKSPACE_ROOT.
OPENCODE_DATA_DIR=

# Optional. debug | info | warn | error
LOG_LEVEL=info

# Optional. Trust X-Forwarded-For for rate limiting.
# Enable only when a trusted reverse proxy sets that header.
TRUST_PROXY=false
